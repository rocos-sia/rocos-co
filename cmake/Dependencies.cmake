find_package(Git REQUIRED)
find_package(Threads REQUIRED)
if(NOT yaml-cpp_DIR AND NOT TARGET yaml-cpp)
    message(STATUS "System yaml-cpp requires libyaml-cpp-dev (scripts/install-deps-ubuntu-22.04.sh)")
endif()
find_package(yaml-cpp CONFIG REQUIRED)
set(CANOPENNODE_SOURCE_DIR "${PROJECT_SOURCE_DIR}/3rdparty/CANopenNode" CACHE PATH "CANopenNode v4 checkout")
set(ROCOS_SHM_SOURCE_DIR "${PROJECT_SOURCE_DIR}/3rdparty/rocos-shm" CACHE PATH "rocos-shm v2 checkout")
set(manifest "ROCOS-CO ${ROCOS_CO_VERSION}\nyaml-cpp ${yaml-cpp_VERSION} (system, MIT)\n")
foreach(dep IN ITEMS CANOPENNODE ROCOS_SHM)
    if(dep STREQUAL "CANOPENNODE")
        set(marker CANopen.c)
        set(license Apache-2.0)
    else()
        set(marker include/rocos_shm/abi.hpp)
        set(license GPL-3.0-or-later)
    endif()
    set(dir "${${dep}_SOURCE_DIR}")
    if(NOT EXISTS "${dir}/${marker}" OR NOT EXISTS "${dir}/.git")
        message(FATAL_ERROR "Missing checkout ${dir}. Run git submodule update --init --recursive")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" rev-parse HEAD
        OUTPUT_VARIABLE sha OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${dir}" status --porcelain
        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(changes)
        string(APPEND sha " (dirty)")
    endif()
    message(STATUS "${dep}: ${dir} @ ${sha}")
    string(APPEND manifest "${dep} ${sha} (${license})\n")
endforeach()
file(WRITE "${PROJECT_BINARY_DIR}/dependencies.txt" "${manifest}")
install(FILES "${PROJECT_BINARY_DIR}/dependencies.txt" DESTINATION ${CMAKE_INSTALL_DOCDIR})
set(ROCOS_SHM_BUILD_WEB OFF)
set(ROCOS_SHM_BUILD_TESTS OFF)
# rocos-shm declares options under an older CMake minimum.
set(CMAKE_POLICY_DEFAULT_CMP0077 NEW)
add_subdirectory("${ROCOS_SHM_SOURCE_DIR}" "${PROJECT_BINARY_DIR}/third-party/shm" EXCLUDE_FROM_ALL)
include("${CMAKE_CURRENT_LIST_DIR}/CANopenNode.cmake")
